{
  "description": "Video-Sperre: blockt Bezahl-/Upload-/Telemetrie-Befehle, HyperFrames am Starter vorbei und Änderungen an Original-Dateien. Abschluss-Sperre: kein „fertig“, solange ein neues Video nicht gemessen ist.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sperre.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/abschluss.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
