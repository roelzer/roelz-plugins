{
  "description": "Dev-Team: Grundgesetz in jeder Sitzung (auch Cloud), Pfade für jeden Agenten, Wächter (nur lesende Werkzeuge blockieren bei Zeitüberschreitung nicht; Teamzwang, Schreibrechte, verdeckte Abnahmetests, Schutzschalter), Fertig-Prüfung der Entwickler und automatisches Agenten-Protokoll in docs/AGENTEN_LOG.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/sitzungsstart.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-kontext.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|LS|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/waechter.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(?!(Read|Grep|Glob|LS|NotebookRead)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/waechter.sh\"",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/fertig-pruefung.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/agenten-log.sh\" ende",
            "timeout": 15
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/einstellungs-schutz.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
